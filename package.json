{
  "name": "ssl-monitoring",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "SSL certificate monitoring — Source of Truth Excel, database Postgres (Supabase atau lokal), siap Vercel",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "node scripts/serve.js",
    "start:lan": "node scripts/serve.js --lan",
    "start:raw": "next start -H 127.0.0.1 -p 3000",
    "sample:excel": "node scripts/make-sample-excel.js",
    "scan": "node --no-warnings scripts/scan.js",
    "reset": "node --no-warnings scripts/reset.js",
    "reset-admin": "node --no-warnings scripts/reset-admin.js",
    "import-local": "node --no-warnings scripts/import-local.js",
    "scanner": "node scripts/serve.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  }
}
