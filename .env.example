# Salin file ini menjadi .env.local (laptop) atau isi di Vercel → Settings → Environment Variables.

# --- Database ---
# Kosong  → database lokal di folder data/pg (tanpa server, tanpa internet).
# Diisi   → Supabase / Postgres. Ambil dari Supabase → Project Settings → Database → Connection string → URI.
#           Pakai "Transaction pooler" (port 6543) untuk Vercel; untuk laptop/scanner kantor boleh pooler atau direct (5432).
#           Integrasi Supabase–Vercel mengisi POSTGRES_URL otomatis; aplikasi membaca DATABASE_URL, POSTGRES_URL, atau SUPABASE_DB_URL.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Vercel Cron ---
# Wajib di Vercel: rahasia untuk /api/cron (Vercel Cron mengirim "Authorization: Bearer <CRON_SECRET>" otomatis).
# CRON_SECRET=isi-dengan-teks-acak-panjang

# --- Nilai awal pengaturan (selanjutnya diubah dari menu Settings) ---
# SCAN_RUNNER=local         # local = scanner kantor, cloud = Vercel Cron (default cloud)
# SCAN_INTERVAL_HOURS=6
# SCAN_CONCURRENCY=10
# SCAN_TIMEOUT_MS=10000
# WARNING_DAYS=60
# URGENT_DAYS=7

# --- Lain-lain ---
# SCAN_BUDGET_MS=50000      # batas waktu satu kali scan di Vercel (sisanya dilanjutkan otomatis)
# APP_TZ_OFFSET=+07:00      # zona waktu filter tanggal Audit Log (default WIB)
